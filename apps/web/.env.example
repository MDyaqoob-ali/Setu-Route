# NE-ROUTE Web Frontend Environment Configuration
# Ministry of Development of North Eastern Region (MDoNER)

# Base URL for FastAPI Backend Gateway
NEXT_PUBLIC_API_URL=http://127.0.0.1:8008/api/v1

# Optional MapTiler Raster/Vector API Key for high-resolution satellite basemaps
# Default fallback uses OpenStreetMap standard vector tiles without an external key
NEXT_PUBLIC_MAPTILER_KEY=

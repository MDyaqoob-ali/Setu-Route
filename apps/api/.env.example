# NE-ROUTE FastAPI Backend Environment Configuration
# Ministry of Development of North Eastern Region (MDoNER)

PROJECT_NAME=NE-ROUTE
ENVIRONMENT=development
API_V1_STR=/api/v1
SECRET_KEY=ne-route-super-secure-production-key-sih-2026-ner-logistics
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database Connection (Defaults to high-performance SQLite WAL database in apps/api/neroute.db)
DATABASE_URL=sqlite+aiosqlite:///neroute.db

# In-Memory Real-Time WebSocket Broker (True uses connection manager without external Redis requirement)
USE_IN_MEMORY_BROKER=True
REDIS_URL=redis://localhost:6379/0

# Network Binding
HOST=0.0.0.0
PORT=8008
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Uploads Directory
UPLOAD_DIR=./uploads

# Default Northeast India Geographic Coordinates
DEFAULT_MAP_CENTER_LAT=25.8
DEFAULT_MAP_CENTER_LNG=93.5
DEFAULT_MAP_ZOOM=7.2

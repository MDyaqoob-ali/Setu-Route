# NE-ROUTE - Environment Configuration
ENVIRONMENT=development
PROJECT_NAME="NE-ROUTE"
API_V1_STR="/api/v1"
SECRET_KEY="ne-route-super-secure-production-key-sih-2026-ner-logistics"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database - Defaults to SQLite with GeoJSON/Spatial support / PostgreSQL with PostGIS
DATABASE_URL="sqlite+aiosqlite:///./neroute.db"
# Production PostgreSQL/PostGIS:
# DATABASE_URL="postgresql+asyncpg://neroute:neroute_secure_pass@localhost:5432/neroute_db"

# Redis Cache / PubSub
REDIS_URL="redis://localhost:6379/0"
USE_IN_MEMORY_BROKER=true

# Server
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000"

# GIS & Map Settings
DEFAULT_MAP_CENTER_LAT=25.8
DEFAULT_MAP_CENTER_LNG=93.5
DEFAULT_MAP_ZOOM=7.2
MAP_TILE_STYLE="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
